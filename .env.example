# Copy this file to .env and fill in your keys.

# Required: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Recommended: free key from https://tavily.com (1,000 searches/month).
# Without it, Verdict falls back to DuckDuckGo, which needs no key but returns
# fewer results, especially on cloud servers.
TAVILY_API_KEY=

# Optional: choose other free models
# CREW_MODEL=gemini-3.6-flash
# CREW_FALLBACK_MODEL=gemini-3.5-flash-lite
